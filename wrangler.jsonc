{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incident-triage-assistant",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INCIDENT_AGENT",
        "class_name": "IncidentAgent"
      },
      {
        "name": "INCIDENT_INDEX",
        "class_name": "IncidentIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["IncidentAgent", "IncidentIndex"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
